# Public example only. Export these in the API process environment.
# Existing BADEM admin/device/node settings are still required; see README.md.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Preferred: local Solana CLI JSON keypair outside the repository; ~ expands.
SOLANA_PAYER_KEYPAIR_PATH=~/.config/solana/badem-devnet-payer.json
# Alternative: Base58 or JSON 64-byte keypair. Set only one payer source.
# Never commit a filled key value. This file is not loaded automatically.
SOLANA_PAYER_PRIVATE_KEY=
