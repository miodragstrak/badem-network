# Public example only. Export these in the API process environment.
# Existing BADEM admin/device/node settings are still required; see README.md.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Local disposable Devnet payer: Base58 or JSON 64-byte Solana keypair.
# Never commit a filled value. The service does not load this file automatically.
SOLANA_PAYER_PRIVATE_KEY=
