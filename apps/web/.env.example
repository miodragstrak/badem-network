# Vercel server-only values. Never prefix these with VITE_.
BADEM_API_ORIGIN=https://api.badem.network
BADEM_SERVER_ADMIN_KEY=

# Browser-safe Supabase Auth configuration only. Use the canonical project URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional browser-safe Maps JavaScript API configuration. Both are required.
# Use a SEPARATE key restricted to your website referrers + Maps JavaScript API.
# Never reuse GOOGLE_PLACES_API_KEY or any server-side secret here.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Same Supabase project, server-only runtime configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Prefer the new secret key. Configure ONLY ONE of these two privileged values.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact invited emails. Empty means nobody is admitted.
BADEM_BETA_EMAIL_ALLOWLIST=

# Optional server-only local target. Discovery still requires Auth and quota.
# Set BADEM_SERVER_ADMIN_KEY to the matching disposable local backend key.
BADEM_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional local proof identifiers; no browser admin key is supported.
# Public builds use the documented proof receipt without live API requests.
VITE_BADEM_JOB_ID=
VITE_BADEM_PROOF_ID=
VITE_BADEM_NODE_ID=
VITE_BADEM_PROOF_HASH=
