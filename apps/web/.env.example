# Vercel server-only values. Never prefix these with VITE_.
BADEM_API_ORIGIN=https://api.badem.network
BADEM_SERVER_ADMIN_KEY=

# Trusted local Vite development only; all builds strip the key and API override.
# Use a disposable local backend key, never a production credential.
VITE_BADEM_API_URL=/badem-api
VITE_BADEM_ADMIN_KEY=
# Optional server-only development proxy target (default port 8000).
BADEM_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional trusted-local live proof configuration; public builds use fallback.
VITE_BADEM_JOB_ID=
VITE_BADEM_PROOF_ID=
VITE_BADEM_NODE_ID=
VITE_BADEM_PROOF_HASH=
