{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/discovery/**/*.js": { "maxDuration": 120 }, "api/beta-session.js": { "maxDuration": 15 } },
  "rewrites": [
    {
      "source": "/badem-api/auth/session",
      "destination": "/api/beta-session"
    },
    {
      "source": "/badem-api/api/manufacturing-requests",
      "destination": "/api/discovery/manufacturing-requests"
    },
    {
      "source": "/badem-api/api/manufacturing-requests/:id/specification",
      "destination": "/api/discovery/manufacturing-requests/:id/specification"
    },
    {
      "source": "/badem-api/api/manufacturing-requests/:id/discover",
      "destination": "/api/discovery/manufacturing-requests/:id/discover"
    },
    {
      "source": "/badem-api/api/partner-candidates/:id",
      "destination": "/api/discovery/partner-candidates/:id"
    },
    {
      "source": "/badem-api/(.*)?",
      "destination": "/api/discovery/blocked"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
